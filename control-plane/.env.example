# Postgres connection for the control plane (separate DB from wwebjs-api)
DATABASE_URL=postgres://user:pass@localhost:5432/wsapi_cp

# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string

# Admin account (no DB row). Generate the hash with: npm run hash -- 'yourpassword'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Upstream wwebjs-api the control plane proxies to (internal, never public)
WWEBJS_BASE_URL=http://localhost:3000
WWEBJS_GLOBAL_API_KEY=your-global-wwebjs-api-key
